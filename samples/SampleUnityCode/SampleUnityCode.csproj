<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The sample exists to produce OPL001, OPL002, OPL003 and OPL006. Keep those as warnings even when CI
         builds the solution with -warnaserror, so build/verify-sample.ps1 can assert them. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);OPL001;OPL002;OPL003;OPL006</WarningsNotAsErrors>
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);OPL001;OPL002;OPL003;OPL006</MSBuildWarningsNotAsErrors>
    <!-- Unity defines this in the editor. The sample defines it so the `#if UNITY_EDITOR` allocation
         in SampleBehaviour.cs is compiled, and the suppressor is exercised on real code. -->
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ObjectPoolLinter\ObjectPoolLinter.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Code fixes only surface in the IDE lightbulb -->
    <ProjectReference Include="..\..\src\ObjectPoolLinter.CodeFixes\ObjectPoolLinter.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>