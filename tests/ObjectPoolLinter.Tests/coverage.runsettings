<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage for CI: build/check-coverage.ps1 reads the Cobertura report this writes. Only the
     shipped assemblies count; the test project and the Roslyn testing libraries are excluded. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[ObjectPoolLinter]*,[ObjectPoolLinter.CodeFixes]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
