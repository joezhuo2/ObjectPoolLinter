<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ObjectPoolLinter</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- XML docs for the public API ship in the NuGet package next to the DLL. A public type or
         member without a doc comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions: Directory.Packages.props -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests point the local telemetry file at a temporary path. -->
    <InternalsVisibleTo Include="ObjectPoolLinter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectPoolLinter\ObjectPoolLinter.csproj" />
  </ItemGroup>

</Project>
