<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ObjectPoolLinter</PackageId>
    <Version>1.6.3</Version>
    <Authors>Joe Zhuo</Authors>
    <Description>Roslyn analyzer for Unity C# that flags allocations in hot paths - new objects, hidden allocations such as strings, closures, LINQ (including LINQ-style extension methods), boxing, iterator and async state machines and boxed foreach enumerators, and allocating Unity APIs, outside Burst-compiled code - reports Unity job structs holding managed fields, native containers (NativeArray, NativeList, ...) that are not disposed on every path, Resources.Load and Addressables loads in hot paths, and GetComponent and GameObject.Find lookups that belong in Awake, and offers code fixes that route object allocations through an object pool - writing the pool class when none exists - rent local arrays from ArrayPool&lt;T&gt;.Shared inside a try/finally, and rewrite closures, delegates, string interpolation, simple LINQ chains, tag comparisons, GetComponents calls and Input.touches into cached, reused or non-allocating forms, minimizing GC and frame hitches. Includes a source generator that writes the pool class itself from an [ObjectPool] attribute, and a suppressor that stays quiet for allocations behind a first-frame guard, an editor-only region, a static latch or a field assignment. Configurable from .editorconfig, with a warning for misspelled options.</Description>
    <PackageTags>roslyn;analyzer;analyzers;unity;performance;allocation;object-pool;gc;codefix;sourcegenerator</PackageTags>
    <PackageProjectUrl>https://github.com/joezhuo2/ObjectPoolLinter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joezhuo2/ObjectPoolLinter.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageType>Analyzer</PackageType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    The copyright runs from the first release year to the year the package is built, so it never
    goes stale: "2026" while that is the current year, "2026-2027" after.
  -->
  <PropertyGroup>
    <_CopyrightFirstYear>2026</_CopyrightFirstYear>
    <_CopyrightCurrentYear>$([System.DateTime]::UtcNow.ToString('yyyy'))</_CopyrightCurrentYear>
    <_CopyrightYears>$(_CopyrightFirstYear)</_CopyrightYears>
    <_CopyrightYears Condition="'$(_CopyrightCurrentYear)' != '$(_CopyrightFirstYear)'">$(_CopyrightFirstYear)-$(_CopyrightCurrentYear)</_CopyrightYears>
    <Copyright>Copyright (c) $(_CopyrightYears) Joe Zhuo</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectPoolLinter\ObjectPoolLinter.csproj" />
    <ProjectReference Include="..\ObjectPoolLinter.CodeFixes\ObjectPoolLinter.CodeFixes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    PackageReleaseNotes is the CHANGELOG.md section whose heading names this version
    ("## [v1.6.2] - ..."), the same section the release workflow publishes as the GitHub release
    notes, so NuGet clients show what changed without leaving the IDE. It is read at pack time rather
    than evaluation time so that a -p:Version=... from the release workflow picks the right section,
    and so that loading the project in an IDE does not read the changelog. A version with no section
    (a local build between releases) falls back to a link to the changelog.
  -->
  <Target Name="_SetPackageReleaseNotes" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ChangelogPath>$(MSBuildThisFileDirectory)..\..\CHANGELOG.md</_ChangelogPath>
      <_ChangelogUrl>$(PackageProjectUrl)/blob/main/CHANGELOG.md</_ChangelogUrl>
      <_Changelog>$([System.IO.File]::ReadAllText('$(_ChangelogPath)'))</_Changelog>
      <_ReleaseNotesPattern>(?s)^.*?\n## \[v$([System.Text.RegularExpressions.Regex]::Escape('$(Version)'))\][^\n]*\n(.*?)\r?\n(?:## \[|\[[^\]]+\]: ).*$</_ReleaseNotesPattern>
      <_ReleaseNotes Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_Changelog)', '$(_ReleaseNotesPattern)'))">$([System.Text.RegularExpressions.Regex]::Replace('$(_Changelog)', '$(_ReleaseNotesPattern)', '$1').Trim())</_ReleaseNotes>
      <PackageReleaseNotes Condition="'$(_ReleaseNotes)' != ''">$(_ReleaseNotes)

Full changelog: $(_ChangelogUrl)</PackageReleaseNotes>
      <PackageReleaseNotes Condition="'$(_ReleaseNotes)' == ''">See $(_ChangelogUrl)</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <!--
    IncludeBuildOutput is false, so NuGet's normal symbol collection is skipped entirely:
    _GetDebugSymbolsWithTfm is gated on IncludeBuildOutput == true, which also rules out the
    TfmSpecificDebugSymbolsFile extension point. The .pdb files therefore have to ride along
    as ordinary package files. Pack copies them into the .snupkg, which is the point; the
    side effect is that they also stay in the .nupkg.
  -->
  <Target Name="_AddAnalyzersToOutput">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)\ObjectPoolLinter.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)\ObjectPoolLinter.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)\ObjectPoolLinter.pdb" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)\ObjectPoolLinter.CodeFixes.pdb" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
