<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ObjectPoolLinter</PackageId>
    <Version>1.5.6</Version>
    <Authors>Joe Zhuo</Authors>
    <Copyright>Copyright (c) 2026 Joe Zhuo</Copyright>
    <Description>Roslyn analyzer for Unity C# that flags allocations in hot paths - new objects, hidden allocations such as strings, closures, LINQ (including LINQ-style extension methods), boxing, iterator and async state machines and boxed foreach enumerators, and allocating Unity APIs, outside Burst-compiled code - reports Unity job structs holding managed fields, and offers code fixes that route object allocations through an object pool - writing the pool class when none exists - rent local arrays from ArrayPool&lt;T&gt;.Shared inside a try/finally, and rewrite closures, delegates, string interpolation, simple LINQ chains, tag comparisons, GetComponents calls and Input.touches into cached, reused or non-allocating forms, minimizing GC and frame hitches. Includes a source generator that writes the pool class itself from an [ObjectPool] attribute, and a suppressor that stays quiet for allocations behind a first-frame guard, an editor-only region, a static latch or a field assignment. Configurable from .editorconfig, with a warning for misspelled options.</Description>
    <PackageTags>roslyn;analyzer;analyzers;unity;performance;allocation;object-pool;gc;codefix;sourcegenerator</PackageTags>
    <PackageProjectUrl>https://github.com/joezhuo2/ObjectPoolLinter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joezhuo2/ObjectPoolLinter.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageType>Analyzer</PackageType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectPoolLinter\ObjectPoolLinter.csproj" />
    <ProjectReference Include="..\ObjectPoolLinter.CodeFixes\ObjectPoolLinter.CodeFixes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    IncludeBuildOutput is false, so NuGet's normal symbol collection is skipped entirely:
    _GetDebugSymbolsWithTfm is gated on IncludeBuildOutput == true, which also rules out the
    TfmSpecificDebugSymbolsFile extension point. The .pdb files therefore have to ride along
    as ordinary package files. Pack copies them into the .snupkg, which is the point; the
    side effect is that they also stay in the .nupkg.
  -->
  <Target Name="_AddAnalyzersToOutput">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)\ObjectPoolLinter.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)\ObjectPoolLinter.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)\ObjectPoolLinter.pdb" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)\ObjectPoolLinter.CodeFixes.pdb" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
