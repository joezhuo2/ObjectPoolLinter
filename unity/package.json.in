{
  "name": "com.joezhuo.objectpoollinter",
  "version": "__VERSION__",
  "displayName": "ObjectPoolLinter",
  "description": "Roslyn analyzer for Unity C# that flags allocations in hot paths (Update, FixedUpdate, OnTriggerStay, ...): new objects, hidden allocations such as strings, closures, LINQ, boxing, iterator and async state machines and boxed foreach enumerators, and allocating Unity APIs. Also flags job structs holding managed fields, native containers that are not disposed, Resources.Load and Addressables loads, and GetComponent and GameObject.Find lookups in hot paths, and skips Burst-compiled code. Offers code fixes that route object allocations through an object pool.",
  "unity": "__UNITY_VERSION__",
  "keywords": [
    "roslyn",
    "analyzer",
    "performance",
    "allocation",
    "object-pool",
    "gc"
  ],
  "author": {
    "name": "Joe Zhuo",
    "url": "https://github.com/joezhuo2/ObjectPoolLinter"
  },
  "documentationUrl": "https://github.com/joezhuo2/ObjectPoolLinter#readme",
  "changelogUrl": "https://github.com/joezhuo2/ObjectPoolLinter/blob/main/CHANGELOG.md",
  "licensesUrl": "https://github.com/joezhuo2/ObjectPoolLinter/blob/main/LICENSE"
}
