<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Measures what ObjectPoolLinter adds to a compile: the same generated Unity-style project compiled
    with and without the analyzers. How to run it, the results, and how to read them:
    docs/benchmarks.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions: Directory.Packages.props. Roslyn resolves to the benchmark version there, not the shipped 3.8.0. -->
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Unity API surface the tests compile against. -->
    <Compile Include="..\..\tests\ObjectPoolLinter.Tests\SharedUnityStub.cs" Link="SharedUnityStub.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ObjectPoolLinter\ObjectPoolLinter.csproj" />
  </ItemGroup>

</Project>
