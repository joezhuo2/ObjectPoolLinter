# Normalize line endings: LF in the repository, native on checkout.
* text=auto

*.cs     text diff=csharp
*.md     text
*.csproj text
*.slnx   text
*.props  text
*.targets text
*.json   text
*.yml    text
*.yaml   text

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.snk binary
*.dll binary
*.exe binary
